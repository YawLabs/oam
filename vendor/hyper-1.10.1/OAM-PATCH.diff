+            max: usize,
+            lenient: bool,
+        ) -> Option<Result<Option<HeaderMap>, io::Error>> {
+            let mut scratch = b"3\r\nabc\r\n0\r\n".to_vec();
+            scratch.extend(trailers.as_bytes());
