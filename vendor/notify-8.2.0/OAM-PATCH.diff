+// oam: Windows reports discarded notification details as a zero-byte
+// successful completion or as ERROR_NOTIFY_ENUM_DIR (backported from notify
+// 9.0.0-rc.5, which reports them the same way).
+fn completion_rescan_event(error_code: u32, bytes_written: u32) -> Option<Event> {
+    (error_code == ERROR_NOTIFY_ENUM_DIR || (error_code == ERROR_SUCCESS && bytes_written == 0))
+        .then(|| Event::new(EventKind::Other).set_flag(Flag::Rescan))
+}
+
+// oam: a watch that ends on an OS error is reported to the handler before it
+// is dropped, so the caller learns that it ended and why.
+fn watch_ended_error(error_code: u32, dir: &Path) -> Error {
+    Error::io(std::io::Error::from_raw_os_error(error_code as i32)).add_path(dir.to_path_buf())
+}
